# lockedgroove compute: local runner configuration (docs/CONTRACTS.md section 1).
# Copy to analysis/.env (gitignored). The same three values go into the Modal
# secret named `lockedgroove` for the hosted runner.

# Same Supabase project as the web app (CrateAI, us-east-2).
SUPABASE_URL=https://ufmpwtjtyzmfucjyuhqo.supabase.co

# Project Settings -> API -> service_role. Bypasses RLS: server side only, never in web/.env.local's public vars.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Shared bearer secret checked by POST /dispatch. Must equal COMPUTE_DISPATCH_SECRET in web/.env.local.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPUTE_DISPATCH_SECRET=replace-with-a-long-random-string

# Optional: where model weights are cached (the Modal volume mounts at /cache).
# LOCKEDGROOVE_MODEL_CACHE=

# Optional local runner bind (defaults shown).
# LOCKEDGROOVE_HOST=127.0.0.1
# LOCKEDGROOVE_PORT=8787
