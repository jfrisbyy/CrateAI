# Copy to .env.local. Every variable from docs/CONTRACTS.md section 1 (web).

# Supabase project (public; safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://ufmpwtjtyzmfucjyuhqo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server routes only. Never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Compute dispatcher: the Modal web endpoint, or the local runner
# (cd analysis && uv run lockedgroove-server -> http://127.0.0.1:8787).
# Leave unset and jobs stay queued; the UI says "compute not configured".
COMPUTE_DISPATCH_URL=http://127.0.0.1:8787
COMPUTE_DISPATCH_SECRET=change-me-and-share-with-compute

# Chat, breakdown narration and the search query parser (Phases 4, 6, 8).
# Without it /api/chat answers 503 and search runs the rules parser alone.
ANTHROPIC_API_KEY=

# Web information tools (Phase 5): "brave" (default) or "tavily", plus that
# provider's key. Responses are cached in web_cache (needs the service role key;
# otherwise an in-memory cache per instance).
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Phase 10: billing and public URL (see docs/RUNBOOK.md section 6)
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
