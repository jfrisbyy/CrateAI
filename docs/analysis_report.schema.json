    "DrumHit": {
      "additionalProperties": false,
      "description": "One position of a per-section drum pattern on a 16th grid.\n\n``step`` is 0..15 within the bar. ``frequency`` is the fraction of bars in\nthe section where a hit lands on this step. ``velocity`` is the mean\nnormalized hit strength. ``offset_ms`` is the mean measured offset from the\ngrid; positive is late. Offsets are what make the MIDI export keep the feel.",
      "properties": {
        "step": {
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "velocity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Velocity",
          "type": "number"
        },
        "frequency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Frequency",
          "type": "number"
        },
        "offset_ms": {
          "default": 0.0,
          "title": "Offset Ms",
          "type": "number"
        }
      },
      "required": [
        "step",
        "velocity",
        "frequency"
      ],
      "title": "DrumHit",
      "type": "object"
    },
